# Load the Toffoli library cell
# comment if not necessary
# read_verilog -lib toffoli.v

# Load the circuit
read_verilog circuit.v

# Synthesize without automatic ABC
synth -top circuit -flatten -noabc

# Map to intermediate gates
# Add or remove gates here
abc -g AND,XOR

# Replace gates with Toffoli cells
# comment if not necessary
# techmap -map map.v

# Clean and verify
clean -purge
check
stat

# Visualize
# comment if not necessary
# show -format svg -prefix circ

# Export netlist
write_json mapped.json
